# ConfeitaPro SaaS - Exemplo de Variáveis de Ambiente
# Duplique este arquivo como .env e preencha suas credenciais

# Firebase Config (Google Auth & Firestore)
# Obtenha em: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Stripe Config (Checkout & Planos)
# Obtenha em: https://dashboard.stripe.com/payment-links
VITE_STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/test_confeitapro_pro
VITE_STRIPE_PAYMENT_LINK_MASTER=https://buy.stripe.com/test_confeitapro_master
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_sample

# Google Gemini API (Chef IA)
VITE_GEMINI_API_KEY=
